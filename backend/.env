# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real secrets.

APP_NAME="URL Shortener API"
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/urlshortener
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=3600

JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

SHORT_CODE_LENGTH=7
BASE_REDIRECT_URL=http://localhost:8000

# JSON array format required by pydantic-settings
CORS_ORIGINS=["http://localhost:5173"]
